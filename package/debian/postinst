#!/bin/sh
set -e

PACKAGE_NAME="deb-harden-ssh"
SCRIPT_NAME="postinst"

# --- Helper Functions ---

add_ssh_users_group() {
    if ! getent group ssh-users >/dev/null; then
        addgroup --system ssh-users
        echo "Adding system group 'ssh-users'"
        echo "Users must be added to the group 'ssh-users' to log in using SSH"
    fi
}

harden_ssh_config_permissions() {
    if ! dpkg-statoverride --list "/root/.ssh" >/dev/null 2>&1; then
        dpkg-statoverride --update --add "root" "root" "0700" "/root/.ssh"
        echo "Setting permissions on '/root/.ssh' directory to 700"
    fi
    if ! dpkg-statoverride --list "/etc/ssh/ssh_config" >/dev/null 2>&1; then
        dpkg-statoverride --update --add "root" "root" "0644" "/etc/ssh/ssh_config"
        echo "Setting permissions on '/etc/ssh/ssh_config' to 644"
    fi
    if ! dpkg-statoverride --list "/etc/ssh/ssh_config.d" >/dev/null 2>&1; then
        dpkg-statoverride --update --add "root" "root" "0755" "/etc/ssh/ssh_config.d"
        echo "Setting permissions on '/etc/ssh/ssh_config.d/' directory to 755"
    fi
    if ! dpkg-statoverride --list "/etc/ssh/sshd_config" >/dev/null 2>&1; then
        dpkg-statoverride --update --add "root" "root" "0600" "/etc/ssh/sshd_config"
        echo "Setting permissions on '/etc/ssh/sshd_config' to 600"
    fi
    if ! dpkg-statoverride --list "/etc/ssh/sshd_config.d" >/dev/null 2>&1; then
        dpkg-statoverride --update --add "root" "root" "0700" "/etc/ssh/sshd_config.d"
        echo "Setting permissions on '/etc/ssh/sshd_config.d/' directory to 700"
    fi
}

reload_systemd_daemon() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
}

reload_ssh() {
    if sshd -t; then
        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ssh; then
            echo "[*] SSH service is active."
            if command -v deb-systemd-invoke >/dev/null 2>&1; then
                deb-systemd-invoke reload ssh || true
            fi
        else
            echo "[!] WARNING: SSH server is not running." >&2
        fi
    else
        echo "[!] WARNING: Invalid SSH configuration! Service not reloaded." >&2
        return 1
    fi
}

reload_fail2ban() {
    if command -v fail2ban-server >/dev/null 2>&1; then
        echo "[*] Validating fail2ban configuration..."
        if fail2ban-server -t; then
            if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet fail2ban; then
                echo "[*] Reloading the fail2ban service."
                if command -v deb-systemd-invoke >/dev/null 2>&1; then
                    deb-systemd-invoke reload fail2ban || true
                fi
            else
                echo "[!] fail2ban service not active." >&2
            fi
        else
            echo "[!] ERROR: Invalid fail2ban configuration! Service not reloaded." >&2
            return 1
        fi
    else
        echo "[!] fail2ban is not installed." >&2
    fi
}

reload_audit_rules() {
    if command -v augenrules >/dev/null 2>&1; then
        echo "[*] Validating auditd rules..."
        if augenrules --check; then
            if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet auditd; then
                echo "[*] Compiling and loading auditd rules into the kernel."
                augenrules --load || true
                if command -v deb-systemd-invoke >/dev/null 2>&1; then
                    deb-systemd-invoke restart auditd || true
                fi
            else
                echo "[!] auditd service not active, skipping kernel rule load." >&2
            fi
        else
            echo "[!] ERROR: Audit rule syntax validation failed! Rules not loaded." >&2
            return 1
        fi
    else
        echo "[!] augenrules not installed, skipping audit rule reload." >&2
    fi
}

# --- Main Logic Execution ---

case "$1" in
    configure)
        harden_ssh_config_permissions
        reload_systemd_daemon
        reload_ssh
        reload_fail2ban
        reload_audit_rules
        add_ssh_users_group
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        ARG="${1:-none}"
        echo "${PACKAGE_NAME}: ${SCRIPT_NAME} called with unknown argument \`${ARG}\`" >&2
        exit 1
        ;;

esac

# Automatically injects standard debhelper maintenance routines
#DEBHELPER#

exit 0
