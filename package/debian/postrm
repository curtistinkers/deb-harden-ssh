#!/bin/sh
set -e

PACKAGE_NAME="deb-harden-ssh"
SCRIPT_NAME="postrm"

# --- Helper Functions ---

# Inform the sysadmin about the remaining group rather than deleting it:
notify_admin_about_ssh_users_group() {
    if getent group ssh-users >/dev/null; then
        echo "Note: The 'ssh-users' group was left intact to avoid breaking user group memberships." >&2
        echo "To remove it manually, run: delgroup ssh-users" >&2
    fi
}

reload_ssh() {
    if sshd -t >/dev/null 2>&1; then
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke reload ssh || true
        fi
    fi
}

revert_sshd_config_permissions() {
    if dpkg-statoverride --list "/etc/ssh/sshd_config" >/dev/null 2>&1; then
        dpkg-statoverride --remove "/etc/ssh/sshd_config"
    fi
